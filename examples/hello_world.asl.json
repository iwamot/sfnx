{
  "Comment": "A Hello World example that demonstrates various state types.",
  "QueryLanguage": "JSONata",
  "StartAt": "wait",
  "States": {
    "wait": {
      "Type": "Wait",
      "Seconds": 3,
      "Assign": {
        "checkpoint_count": 1
      },
      "Next": "start_date"
    },
    "start_date": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "format_execution_start_date.return",
          "States": {
            "format_execution_start_date.return": {
              "Type": "Succeed",
              "Output": "{% $fromMillis($toMillis($states.context.State.EnteredTime), '[M01]/[D01]') %}"
            }
          }
        },
        {
          "StartAt": "snapshot_execution_elapsed_time.return",
          "States": {
            "snapshot_execution_elapsed_time.return": {
              "Type": "Succeed",
              "Output": "{% $millis() / 1000 - $toMillis($states.context.Execution.StartTime) / 1000 %}"
            }
          }
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.QueryEvaluationError"
          ],
          "Assign": {
            "start_date": "Failed to format",
            "elapsed": "Failed to calculate"
          },
          "Next": "return"
        }
      ],
      "Assign": {
        "start_date": "{% $states.result[0] %}",
        "elapsed": "{% $states.result[1] %}"
      },
      "Next": "return"
    },
    "return": {
      "Type": "Succeed",
      "Output": {
        "Summary": "{% 'This Hello World execution began on ' & $start_date & '. The state machine ran for ' & $string($elapsed) & ' seconds before the snapshot was taken, passing through ' & $string($checkpoint_count + 1) & ' checkpoints, and has successfully completed.' %}"
      }
    }
  }
}
