{
  "Comment": "Transcribe an audio file, polling the job until it finishes.",
  "QueryLanguage": "JSONata",
  "StartAt": "startTranscriptionJob",
  "States": {
    "startTranscriptionJob": {
      "Type": "Task",
      "Comment": "Transcribe has no .sync integration, so the machine polls the job itself.",
      "Resource": "arn:aws:states:::aws-sdk:transcribe:startTranscriptionJob",
      "Arguments": {
        "TranscriptionJobName": "{% $states.context.Execution.Name %}",
        "Media": {
          "MediaFileUri": "{% $states.context.Execution.Input.uri %}"
        },
        "IdentifyLanguage": true
      },
      "Assign": {
        "name": "{% $states.context.Execution.Name %}",
        "polls": 0
      },
      "Next": "while"
    },
    "while": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $polls < 20 %}",
          "Next": "wait"
        }
      ],
      "Default": "raise_2"
    },
    "wait": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "job"
    },
    "job": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:transcribe:getTranscriptionJob",
      "Arguments": {
        "TranscriptionJobName": "{% $name %}"
      },
      "Assign": {
        "job": "{% $states.result.TranscriptionJob %}",
        "status": "{% $states.result.TranscriptionJob.TranscriptionJobStatus %}"
      },
      "Next": "if"
    },
    "if": {
      "Type": "Choice",
      "Choices": [
        {
          "Condition": "{% $status = 'COMPLETED' %}",
          "Next": "return"
        },
        {
          "Condition": "{% $status = 'FAILED' %}",
          "Next": "raise"
        },
        {
          "Condition": "{% ($polls + 1) < 20 %}",
          "Next": "wait",
          "Assign": {
            "polls": "{% $polls + 1 %}"
          }
        }
      ],
      "Default": "raise_2",
      "Assign": {
        "polls": "{% $polls + 1 %}"
      }
    },
    "return": {
      "Type": "Succeed",
      "Output": {
        "transcript": "{% $job.Transcript.TranscriptFileUri %}"
      }
    },
    "raise": {
      "Type": "Fail",
      "Error": "TranscriptionFailed",
      "Cause": "{% $job.FailureReason %}"
    },
    "raise_2": {
      "Type": "Fail",
      "Error": "StillRunning",
      "Cause": "{% $name & ' is still running after 20 polls' %}"
    }
  }
}
